# PostgreSQL connection string for Prisma
# For Neon: get from Dashboard → Connection Details
DATABASE_URL="postgresql://user:password@localhost:5432/excalidraw"

# Secret key for signing JWT tokens (used by http-backend & ws-backend)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-me"

# Port for the HTTP backend (default: 3001)
HTTP_PORT="3001"

# Port for the WebSocket backend (default: 8080)
WS_PORT="8080"

# Comma-separated list of allowed CORS origins (http-backend)
# In production: https://your-domain.com
ALLOWED_ORIGINS="http://localhost:3000"

# Frontend-only: backend URLs (NEXT_PUBLIC_ prefix required for Next.js)
# These are baked into the frontend at build time
# In production: https://your-domain.com/api and wss://your-domain.com/ws
NEXT_PUBLIC_HTTP_BACKEND="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:8080"
